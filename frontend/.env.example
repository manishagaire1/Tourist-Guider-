# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Public site origin (no trailing slash) — used for canonical URLs, Open
# Graph og:url, and sitemap.xml entries generated by scripts/prerender.mjs.
# Set this to your real deployed domain before building for production.
VITE_SITE_URL=http://localhost:5173

# Set to "false" once real API keys below are filled in and backend endpoints are live.
VITE_USE_MOCK_DATA=true

# Map provider (pick one; Mapbox is used by default in the service layer)
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=

# OpenWeather API (https://openweathermap.org/api)
VITE_OPENWEATHER_KEY=
