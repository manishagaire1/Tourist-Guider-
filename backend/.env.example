SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. Example for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/tourist_guide

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Third-party API keys (server-side only — never exposed to the frontend)
OPENWEATHER_API_KEY=
MAPS_API_KEY=

# Viator Partner API — https://docs.viator.com/partner-api/
# Leave VIATOR_API_KEY blank to run with booking fully disabled ("Booking not
# available" everywhere) rather than fake availability.
VIATOR_API_KEY=
VIATOR_PARTNER_ID=
VIATOR_BASE_URL=https://api.sandbox.viator.com/partner

# exchangerate-api.com (v6) — https://www.exchangerate-api.com/
# Leave CURRENCY_API_KEY blank to run with currency conversion disabled
# (the calculator reports rates unavailable rather than faking one).
CURRENCY_API_KEY=
CURRENCY_API_BASE_URL=https://v6.exchangerate-api.com/v6
